node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
supabase/.temp/

# Harness 1 — local task-lifecycle state; churns every phase transition,
# never committed. See docs discussion in scripts/harness.cjs.
.workspc-engineering/active-task.json
# Harness bug fix — single-use, local-only governance-sync push
# authorization (scripts/harness.cjs's push-authorize command); it
# authorizes exactly one specific push and is deleted/discarded after use,
# never committed.
.workspc-engineering/push-authorization.json
# Harness 4 — transient temp-file-then-rename artifacts for any atomic
# jsonl/JSON write under .workspc-engineering/ (active-task.json,
# notes.jsonl, findings.jsonl, decisions.jsonl); a crash mid-write could
# otherwise leave one of these visible as an untracked file.
.workspc-engineering/.*.tmp-*

# OE-003A Active Agent Nudge Bridge — generated runtime state only. The
# queued message files embed live agent session identifiers (pid, cwd,
# sessionId) and both files are rewritten on every delivery attempt: this
# is runtime state, not source. The bridge's code, verifier and README are
# committed; only these generated paths are ignored.
.workspc-engineering/agent-nudge-bridge/messages/
.workspc-engineering/agent-nudge-bridge/events.jsonl

# Workspc Orchestrator V5 — runtime state only. The kernel source, docs and
# tests are tracked infrastructure (human decision, Activation Phase 2); this
# directory holds live process state: supervisor.pid, the append-only event
# log, health/cycle snapshots and their .bak copies. Same split already applied
# to the agent-nudge-bridge above.
.workspc-engineering/orchestrator-v5/state/
